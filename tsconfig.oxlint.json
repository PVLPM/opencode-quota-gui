{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "rootDir": "tools/oxlint-anti-slop",
    "outDir": "node_modules/.cache/oxlint-anti-slop",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["tools/oxlint-anti-slop/**/*.ts"]
}
